# Plantilla de variables de entorno para POV Store Uruguay.
# Copiá este archivo a `.env` (gitignored) y completá los valores reales.
# En producción (Vercel): Project Settings → Environment Variables.
#
# ⚠ NUNCA commitear el `.env` con valores reales.

# ─────────────────────────────────────────────────────────────
# Supabase
# Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# Service-role key: server-only. NUNCA exponer al cliente ni prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Algunas rutas leen también SUPABASE_URL como fallback de NEXT_PUBLIC_SUPABASE_URL.
# Setear ambos al mismo valor en entornos server-only.
SUPABASE_URL=https://<your-project>.supabase.co

# ─────────────────────────────────────────────────────────────
# MercadoPago
# Dashboard → Tus integraciones → la app
# ─────────────────────────────────────────────────────────────

# Credenciales → "Access Token" (TEST o PROD según entorno).
MP_ACCESS_TOKEN=<your-mp-access-token>

# Webhooks → "Revelar clave secreta". Es DISTINTO del access token.
# Necesario para verificar la firma HMAC-SHA256 de cada notificación.
MP_WEBHOOK_SECRET=<your-mp-webhook-signing-secret>

# ─────────────────────────────────────────────────────────────
# Order lookup token
# Secret server-only para firmar el token que protege /api/order-details.
# Generá uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────
ORDER_LOOKUP_SECRET=<random-32-byte-hex>

# ─────────────────────────────────────────────────────────────
# Sitio
# Usado para construir URLs de back_urls y notification_url de MP.
# Local: http://localhost:4028
# Prod: https://<tu-dominio>
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:4028
SITE_URL=http://localhost:4028
