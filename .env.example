# Plantilla de variables de entorno para POV Store Uruguay.
# Copiá este archivo a `.env` (gitignored) y completá los valores reales.
# En producción (Vercel): Project Settings → Environment Variables.
#
# ⚠ NUNCA commitear el `.env` con valores reales.

# ─────────────────────────────────────────────────────────────
# Supabase
# Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# Service-role key: server-only. NUNCA exponer al cliente ni prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Algunas rutas leen también SUPABASE_URL como fallback de NEXT_PUBLIC_SUPABASE_URL.
# Setear ambos al mismo valor en entornos server-only.
SUPABASE_URL=https://<your-project>.supabase.co

# ─────────────────────────────────────────────────────────────
# MercadoPago
# Dashboard → Tus integraciones → la app
# ─────────────────────────────────────────────────────────────

# Credenciales → "Access Token" (TEST o PROD según entorno).
MP_ACCESS_TOKEN=<your-mp-access-token>

# Webhooks → "Revelar clave secreta". Es DISTINTO del access token.
# Necesario para verificar la firma HMAC-SHA256 de cada notificación.
MP_WEBHOOK_SECRET=<your-mp-webhook-signing-secret>

# ─────────────────────────────────────────────────────────────
# Order lookup token
# Secret server-only para firmar el token que protege /api/order-details.
# Generá uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────
ORDER_LOOKUP_SECRET=<random-32-byte-hex>

# ─────────────────────────────────────────────────────────────
# Sitio
# Usado para construir URLs de back_urls y notification_url de MP.
# Local: http://localhost:4028
# Prod: https://<tu-dominio>
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:4028
SITE_URL=http://localhost:4028

# Secreto server-only compartido exclusivamente con MatchBot para firmar las
# consultas al catálogo vivo. Generar un valor distinto de cualquier otra key.
MATCHBOT_CATALOG_SECRET=<random-32-byte-hex>
MATCHBOT_COMMERCE_EVENTS_URL=https://<matchbot-project-ref>.supabase.co/functions/v1/commerce-event

# Sólo desarrollo local: habilita /api/integrations/matchbot/visual y su endpoint sin firma.
# No configurar en Vercel Production.
MATCHBOT_PREVIEW_ENABLED=false

# ─────────────────────────────────────────────────────────────
# Upstash Redis (rate-limit en endpoints públicos)
# Crear una database Redis en https://upstash.com (free tier OK).
# Region recomendada: us-east-1 (matchea Vercel default).
# Copiá REST API URL + Token (NO los TCP/redis:// credentials).
# Si faltan, el rate-limit queda deshabilitado (fail-open) — útil en local.
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=<your-upstash-rest-url>
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>

# ─────────────────────────────────────────────────────────────
# Meta (Facebook) Pixel
# Events Manager → Orígenes de datos → tu conjunto de datos → ID del pixel.
# Es un ID público (se expone en el cliente por diseño). Si falta, el pixel
# queda deshabilitado (el sitio funciona igual, sin tracking).
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FB_PIXEL_ID=<your-meta-pixel-id>

# ─────────────────────────────────────────────────────────────
# Resend (mails transaccionales al cliente)
# https://resend.com → API Keys. Permiso "Sending access" alcanza.
# El dominio povstore.uy se verifica en Resend SOLO para enviar; la casilla
# sigue en Spacemail (el MX raíz no se toca), así que las respuestas del
# cliente llegan a info@povstore.uy como siempre.
# Si RESEND_API_KEY falta, el envío es NO-OP y queda un warning en logs
# (fail-open: nunca rompe la actualización de la orden).
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=<your-resend-api-key>
EMAIL_FROM=POV Store <info@povstore.uy>
EMAIL_REPLY_TO=info@povstore.uy
